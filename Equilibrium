import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        for(int i = 0; i < n; i++) {

            int leftsum = 0;
            int rightsum = 0;

            for(int j = 0; j < i; j++) {
                leftsum += arr[j];
            }

            for(int j = i + 1; j < n; j++) {
                rightsum += arr[j];
            }

            if(leftsum == rightsum) {
                System.out.println("Equilibrium Index = " + i);
                return;
            }
        }

        System.out.println("No Equilibrium Index");
    }
}
