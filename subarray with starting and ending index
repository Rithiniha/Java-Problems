public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] arr = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        System.out.print("Enter the starting index: ");
        int si = sc.nextInt();
        System.out.print("Enter the ending index: ");
        int ei = sc.nextInt();
        int [] carr = new int[ei-si+1];
        int index = 0;
        for(int i=si;i<=ei;i++){
            carr[index++] = arr[i];
        }
      System.out.print(Arrays.toString(carr));

    }
}
